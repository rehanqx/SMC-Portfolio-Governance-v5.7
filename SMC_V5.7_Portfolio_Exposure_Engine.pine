//@version=6
indicator(
    title = "Smart Money Concepts V5.7 - Portfolio & Exposure Engine",
    shorttitle = "SMC V5.7 Portfolio",
    overlay = true,
    max_lines_count = 500,
    max_labels_count = 500,
    max_boxes_count = 500
)

// ===================================================
// SECTION 1 — INPUT SETTINGS & CONFIGURATION
// ===================================================

group_port = "━━━ PORTFOLIO GOVERNANCE SETTINGS (V5.7) ━━━"
total_portfolio_equity = input.float(100000.0, "Total Portfolio Equity ($)", minval=1000.0, step=5000.0, group=group_port)
max_portfolio_dd_pct   = input.float(10.0, "Max Portfolio Drawdown Limit (%)", minval=2.0, maxval=25.0, step=1.0, group=group_port)
max_gross_exposure_pct = input.float(200.0, "Max Gross Leverage Limit (%)", minval=50.0, maxval=500.0, step=10.0, group=group_port)
max_net_exposure_pct   = input.float(50.0, "Max Net Directional Limit (%)", minval=10.0, maxval=100.0, step=5.0, group=group_port)
reserve_capital_buffer = input.float(20.0, "Reserve Cash Buffer (%)", minval=5.0, maxval=40.0, step=5.0, group=group_port)

group_visual = "━━━ VISUAL & DASHBOARD SETTINGS ━━━"
show_port_labels = input.bool(true, "Show Portfolio Status Labels", group=group_visual)
show_dashboard   = input.bool(true, "Show Master Portfolio Dashboard", group=group_visual)

col_port_opt  = input.color(#00e676, "OPTIMAL Portfolio Color", group=group_visual)
col_port_warn = input.color(#ff9100, "WARNING Portfolio Color", group=group_visual)
col_port_lock = input.color(#ff1744, "LOCKED / CRITICAL Color", group=group_visual)

// Helper Function for Portfolio Quality Rating
f_get_port_class(score) =>
    score >= 90 ? "Optimal Institutional" : score >= 80 ? "High Efficiency" : score >= 70 ? "Standard Governance" : score >= 60 ? "Sub-Optimal" : "Portfolio Critical"

// ===================================================
// SECTION 2 — CORE TECHNICAL INDICATORS & DATA REUSE
// ===================================================

ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

[plus_di, minus_di, adx_val] = ta.dmi(14, 14)
atr_val = ta.atr(14)
vol_ma  = ta.sma(volume, 20)

bool is_bull_trend = ema50 > ema200
bool is_bear_trend = ema50 < ema200

candle_body = math.abs(close - open)
is_displacement = candle_body > (atr_val * 1.5) and volume > vol_ma

// ===================================================
// SECTION 3 — FROZEN 8-MODULE PORTFOLIO GOVERNANCE ENGINE
// 1. State -> 2. Exposure -> 3. Allocation -> 4. Risk -> 5. Diversification -> 6. Intelligence -> 7. Memory -> 8. API
// ===================================================

var int global_port_id = 1
var float peak_equity  = total_portfolio_equity
peak_equity := math.max(peak_equity, total_portfolio_equity)

float current_dd_pct = math.max(0.0, ((peak_equity - total_portfolio_equity) / peak_equity) * 100.0)

// Simulated Open Positions Net / Gross Exposure Calculation
float open_long_lots  = is_bull_trend ? 1.5 : 0.5
float open_short_lots = is_bear_trend ? 1.5 : 0.2
float lot_contract_val= 100000.0 // Standard Forex Lot Notional

float gross_exposure_usd = (open_long_lots + open_short_lots) * lot_contract_val
float net_exposure_usd   = math.abs(open_long_lots - open_short_lots) * lot_contract_val

float gross_exposure_pct = (gross_exposure_usd / total_portfolio_equity) * 100.0
float net_exposure_pct   = (net_exposure_usd / total_portfolio_equity) * 100.0

// Module 1: Portfolio State Engine
bool is_locked   = current_dd_pct >= max_portfolio_dd_pct or gross_exposure_pct > max_gross_exposure_pct
bool is_warning  = current_dd_pct >= (max_portfolio_dd_pct * 0.7) or net_exposure_pct > (max_net_exposure_pct * 0.8)

string portfolio_state = is_locked ? "LOCKED" : (is_warning ? "WARNING" : "STABLE")
bool portfolio_readiness= not is_locked

// Module 2: Exposure Engine
int exposure_score = math.round(math.max(0.0, 100.0 - (gross_exposure_pct / max_gross_exposure_pct * 50.0)))
string exposure_status = gross_exposure_pct > max_gross_exposure_pct ? "CRITICAL" : (gross_exposure_pct > (max_gross_exposure_pct * 0.75) ? "WARNING" : "SAFE")

// Module 3: Capital Allocation Engine
float reserved_capital_usd = total_portfolio_equity * (reserve_capital_buffer / 100.0)
float allocated_margin_usd = (gross_exposure_usd * 0.01) // 1:100 leverage estimate
float available_capital_usd= math.max(0.0, total_portfolio_equity - reserved_capital_usd - allocated_margin_usd)
int cap_allocation_score   = math.round((available_capital_usd / total_portfolio_equity) * 100.0)

// Module 4: Portfolio Risk Engine
string systemic_risk = is_locked ? "CRITICAL" : (is_warning ? "HIGH" : (adx_val > 25 ? "LOW" : "MODERATE"))
int portfolio_risk_score = is_locked ? 20 : (is_warning ? 65 : 90)

// Module 5: Diversification Engine
int diversification_score = adx_val > 20 ? 85 : 65
string div_quality        = diversification_score >= 80 ? "EXCELLENT" : "ADEQUATE"

// Module 6: Portfolio Intelligence Engine (0-100 Master Score)
int score_dd   = math.round(math.max(0.0, 30.0 - (current_dd_pct / max_portfolio_dd_pct * 30.0)))
int score_exp  = math.round(exposure_score * 0.25)
int score_risk = math.round(portfolio_risk_score * 0.20)
int score_div  = math.round(diversification_score * 0.15)
int score_cap  = math.round(cap_allocation_score * 0.10)

int master_portfolio_score = score_dd + score_exp + score_risk + score_div + score_cap
string portfolio_class     = f_get_port_class(master_portfolio_score)

// Governance Recommendation
string portfolio_recommendation = is_locked ? "SUSPEND_NEW_ALLOCATIONS" : (is_warning ? "RESTRICT_SCALING" : "ALLOW_FULL_ALLOCATION")

// ===================================================
// SECTION 4 — STANDARDIZED PORTFOLIO OUTPUT API
// (Exposed Outputs for Version 6.0 MT5 Expert Advisor Bridge & FIX Gateway)
// ===================================================

string export_PortfolioID             = "PORT_" + str.tostring(global_port_id)
string export_PortfolioState          = portfolio_state
int    export_PortfolioHealth         = master_portfolio_score
int    export_PortfolioScore          = master_portfolio_score
int    export_ExposureScore           = exposure_score
string export_ExposureStatus          = exposure_status
int    export_CapitalAllocationScore  = cap_allocation_score
int    export_PortfolioRiskScore      = portfolio_risk_score
int    export_DiversificationScore    = diversification_score
int    export_CapitalEfficiency       = cap_allocation_score
int    export_PortfolioEfficiency     = master_portfolio_score
bool   export_PortfolioReadiness      = portfolio_readiness
string export_SystemicRisk            = systemic_risk
float  export_NetExposure             = net_exposure_usd
float  export_GrossExposure           = gross_exposure_usd
float  export_AvailableCapital        = available_capital_usd
float  export_AllocatedCapital        = allocated_margin_usd
float  export_ReservedCapital         = reserved_capital_usd
string export_PortfolioRecommendation  = portfolio_recommendation
bool   export_PortfolioWarning        = is_warning
bool   export_PortfolioCritical       = is_locked

// ===================================================
// SECTION 5 — CHARTS & VISUAL PLOTTING
// ===================================================

plot(ema20,  "EMA 20",  color.new(#00e5ff, 60), linewidth=1)
plot(ema50,  "EMA 50",  color.new(#ff9100, 60), linewidth=1)
plot(ema200, "EMA 200", color.new(#d500f9, 60), linewidth=2)

if show_port_labels and barstate.islast
    color lbl_col = is_locked ? col_port_lock : (is_warning ? col_port_warn : col_port_opt)
    label.new(
        x = bar_index + 3,
        y = close,
        text = "SMC V5.7 PORTFOLIO: " + portfolio_state + "\nSCORE: " + str.tostring(master_portfolio_score) + "/100 (" + portfolio_class + ")" + "\nGROSS EXP: $" + str.tostring(math.round(gross_exposure_usd, 0)) + " (" + str.tostring(math.round(gross_exposure_pct, 1)) + "%)" + "\nRECOMMENDATION: " + portfolio_recommendation,
        style = label.style_label_left,
        color = lbl_col,
        textcolor = color.black,
        size = size.small
    )

// ===================================================
// SECTION 6 — MASTER PORTFOLIO DASHBOARD TABLE
// ===================================================

var table db = table.new(
    position=position.top_right,
    columns=2,
    rows=11,
    bgcolor=color.new(#0d1117, 15),
    border_color=color.new(#30363d, 0),
    border_width=1,
    frame_color=color.new(#58a6ff, 50),
    frame_width=1
)

if show_dashboard and barstate.islast
    table.cell(db, 0, 0, "SMC V5.7 PORTFOLIO ENGINE", text_color=#58a6ff, text_size=size.small, bgcolor=color.new(#161b22, 0), text_halign=text.align_center)
    table.cell(db, 1, 0, "PORTFOLIO GOVERNANCE", text_color=#8b949e, text_size=size.small, bgcolor=color.new(#161b22, 0), text_halign=text.align_center)

    table.cell(db, 0, 1, "Portfolio State Status", text_color=#c9d1d9, text_size=size.tiny)
    color st_col = portfolio_state == "STABLE" or portfolio_state == "OPTIMAL" ? #00e676 : (portfolio_state == "WARNING" ? #ff9100 : #f85149)
    table.cell(db, 1, 1, portfolio_state, text_color=st_col, text_size=size.tiny)

    table.cell(db, 0, 2, "Master Portfolio Score", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 2, str.tostring(master_portfolio_score) + "/100 (" + portfolio_class + ")", text_color=master_portfolio_score >= 75 ? #3fb950 : #d29922, text_size=size.tiny)

    table.cell(db, 0, 3, "Gross Portfolio Exposure", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 3, "$" + str.tostring(math.round(gross_exposure_usd, 0)) + " (" + str.tostring(math.round(gross_exposure_pct, 1)) + "%)", text_color=#58a6ff, text_size=size.tiny)

    table.cell(db, 0, 4, "Net Directional Exposure", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 4, "$" + str.tostring(math.round(net_exposure_usd, 0)) + " (" + str.tostring(math.round(net_exposure_pct, 1)) + "%)", text_color=#e3b341, text_size=size.tiny)

    table.cell(db, 0, 5, "Available Capital", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 5, "$" + str.tostring(math.round(available_capital_usd, 2)), text_color=#3fb950, text_size=size.tiny)

    table.cell(db, 0, 6, "Reserved Cash Buffer", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 6, "$" + str.tostring(math.round(reserved_capital_usd, 2)) + " (" + str.tostring(reserve_capital_buffer) + "%)", text_color=#58a6ff, text_size=size.tiny)

    table.cell(db, 0, 7, "Systemic Risk Rating", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 7, systemic_risk, text_color=systemic_risk == "LOW" ? #3fb950 : #f85149, text_size=size.tiny)

    table.cell(db, 0, 8, "Diversification Score", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 8, str.tostring(diversification_score) + "/100 (" + div_quality + ")", text_color=#3fb950, text_size=size.tiny)

    table.cell(db, 0, 9, "Governance Recommendation", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 9, portfolio_recommendation, text_color=#e3b341, text_size=size.tiny)

    table.cell(db, 0, 10, "Current Portfolio Drawdown", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 10, str.tostring(math.round(current_dd_pct, 1)) + "% / " + str.tostring(max_portfolio_dd_pct) + "%", text_color=current_dd_pct < (max_portfolio_dd_pct * 0.7) ? #3fb950 : #f85149, text_size=size.tiny)

// ===================================================
// SECTION 7 — ALERTS
// ===================================================

alertcondition(is_warning, title="Portfolio Warning", message="⚠️ SMC V5.7 PORTFOLIO WARNING: {{ticker}} - Net Exposure / Drawdown Approaching Limit")
alertcondition(is_locked, title="Portfolio Locked", message="🚨 SMC V5.7 PORTFOLIO LOCKED: {{ticker}} - Drawdown / Gross Exposure Limit Breached!")
